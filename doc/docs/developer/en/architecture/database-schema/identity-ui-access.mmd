    users {
        integer id PK "NN"
        varchar email UK "NN"
        varchar full_name
        varchar picture_url
        varchar avatar_preference "NN; default=auto"
        blob avatar_image
        varchar avatar_content_type
        datetime avatar_updated_at
        varchar hashed_password
        integer auth_version "NN; default=1"
        boolean is_active
        varchar role "NN; default=ui_user"
        boolean can_access_ceph_admin "NN; default=0"
        boolean can_access_storage_ops "NN; default=0"
        boolean can_access_manager_bucket_compare "NN; default=0"
        boolean can_access_manager_bucket_integrity_check "NN; default=0"
