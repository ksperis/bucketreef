        boolean can_provision_managed_private_connections "NN; default=0"
        boolean browser_advanced_features_enabled "NN; default=0"
        datetime created_at
        datetime updated_at "NN"
        datetime last_login_at
        varchar ui_language
        boolean quota_alerts_enabled "NN; default=1"
        boolean quota_alerts_global_watch "NN; default=0"
        text ui_preferences_json "NN; default={}"
    }
    ui_groups {
        integer id PK "NN"
        varchar name UK "NN"
