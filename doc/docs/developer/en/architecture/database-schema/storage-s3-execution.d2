  "storage_endpoints": {
    class: table
    tooltip: "PK: id\\nUnique: unnamed(identity_namespace); uq_storage_endpoints_endpoint(endpoint_url); uq_storage_endpoints_name(name)\\nCheck: ck_storage_endpoints_endpoint_url_canonical: endpoint_url = trim(endpoint_url) AND endpoint_url NOT LIKE '%/' AND length(endpoint_url) > 0; ck_storage_endpoints_provider: provider IN ('ceph', 'aws', 'other')\\nIndexes: ix_storage_endpoints_id(id) [index]"
    "id": "INTEGER [PK, NN]"
    "name": "VARCHAR [NN]"
    "endpoint_url": "VARCHAR [NN]"
    "region": "VARCHAR"
    "provider": "VARCHAR [NN]"
    "admin_access_key": "VARCHAR"
    "admin_secret_key": "VARCHAR"
    "identity_namespace": "VARCHAR(32) [NN, UQ]"
    "ceph_admin_allowed": "BOOLEAN [NN]"
    "features_config": "TEXT"
    "latitude": "FLOAT"
    "longitude": "FLOAT"
    "force_path_style": "BOOLEAN [NN]"
    "verify_tls": "BOOLEAN [NN]"
    "is_default": "BOOLEAN [NN]"
    "is_editable": "BOOLEAN [NN]"
    "created_at": "DATETIME [NN]"
    "updated_at": "DATETIME [NN]"
  }
  "endpoint_service_identities": {
    class: table
    tooltip: "PK: id\\nUnique: uq_endpoint_service_identity_kind(endpoint_id, kind)\\nCheck: ck_endpoint_service_identity_ceph_admin_external: kind != 'ceph_admin' OR mode = 'external'; ck_endpoint_service_identity_kind: kind IN ('runtime', 'supervision', 'ceph_admin'); ck_endpoint_service_identity_mode: mode IN ('managed', 'external'); ck_endpoint_service_identity_status: status IN ('not_provisioned', 'missing', 'provisioning', 'ready', 'error', 'revocation_pending', 'disabled')\\nIndexes: ix_endpoint_service_identities_endpoint_id(endpoint_id) [index]"
    "id": "INTEGER [PK, NN]"
