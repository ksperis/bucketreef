        varchar key PK "NN"
        text payload_json "NN"
        datetime created_at "NN"
        datetime updated_at "NN"
    }
    s3_accounts {
        integer id PK "external reference"
    }
    s3_users {
        integer id PK "external reference"
    }
    storage_endpoints {
        integer id PK "external reference"
    }
    users {
        integer id PK "external reference"
    }
