erDiagram
    %% Generated from backend/app/db SQLAlchemy models via app.db.Base.metadata.
    %% Domain: Operations and audit.
    %% PK=primary key, FK=foreign key, UK=single-column unique, NN=not nullable.
    audit_logs {
        integer id PK "NN"
        datetime created_at "NN"
        integer user_id FK
        varchar user_email "NN"
        varchar user_role "NN"
        varchar scope "NN"
        varchar action "NN"
        varchar entity_type
        varchar entity_id
        varchar context_kind
        varchar context_id
        varchar context_name
        varchar status "NN"
        varchar message
        text metadata_json
        varchar request_id
        varchar ip_address
        varchar user_agent
    }
    user_notifications {
        integer id PK "NN"
        integer user_id FK "NN"
        varchar notification_type "NN"
        varchar severity "NN"
        varchar title "NN"
        text message "NN"
        varchar subject_type
        integer storage_endpoint_id FK
        integer s3_account_id FK
        integer s3_user_id FK
        varchar event_key "NN"
        text payload_json "NN; default={}"
        datetime created_at "NN"
        datetime read_at
    }
    webhook_endpoints {
        integer id PK "NN"
        varchar name UK "NN"
        text url "NN"
        boolean enabled "NN; default=0"
        varchar signing_secret
        datetime created_at "NN"
        datetime updated_at "NN"
    }
    webhook_endpoint_subscriptions {
        integer id PK "NN"
        integer endpoint_id FK "NN"
        varchar event_type "NN"
    }
    webhook_deliveries {
        integer id PK "NN"
        varchar delivery_id UK "NN"
        varchar event_id "NN"
        integer endpoint_id FK "NN"
        varchar event_type "NN"
        text payload_json "NN"
        boolean is_test "NN; default=0"
        varchar status "NN; default=pending"
        integer attempt_count "NN; default=0"
        datetime next_attempt_at "NN"
        integer last_http_status
        text last_error
        datetime created_at "NN"
        datetime updated_at "NN"
        datetime delivered_at
    }
    bucket_migrations {
        integer id PK "NN"
        integer created_by_user_id FK
        varchar source_context_id "NN"
