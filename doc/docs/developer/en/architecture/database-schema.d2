"Portal": {
  style.fill: "#f8fafc"
  style.stroke: "#cbd5e1"
  "portal_storage_space_metadata": {
    class: table
    tooltip: "PK: id\\nUnique: uq_portal_storage_space_metadata_account_bucket(account_id, bucket_name)\\nCheck: ck_portal_storage_space_metadata_canonical_sharing: (visibility = 'private' AND share_scope = 'restricted' AND account_member_role IS NULL) OR (visibility = 'shared' AND ((share_scope = 'restricted' AND account_member_role IS NULL) OR (share_scope = 'account' AND account_member_role IS NOT NULL AND account_member_role IN ('Viewer', 'Editor')))); ck_portal_storage_space_metadata_icon_content_type: icon_content_type IS NULL OR icon_content_type IN ('image/jpeg', 'image/png'); ck_portal_storage_space_metadata_icon_preset: icon_preset IN ('bucket', 'folder', 'archive', 'database', 'media'); ck_portal_storage_space_metadata_icon_source: icon_source IN ('preset', 'uploaded'); ck_portal_storage_space_metadata_private_owner: (visibility = 'private' AND owner_user_id IS NOT NULL) OR (visibility = 'shared' AND owner_user_id IS NULL)\\nIndexes: ix_portal_storage_space_metadata_account(account_id) [index]; ix_portal_storage_space_metadata_id(id) [index]; ix_portal_storage_space_metadata_owner_user(owner_user_id) [index]"
  }
  "portal_storage_space_grants": {
    class: table
    tooltip: "PK: id\\nUnique: uq_portal_storage_space_grants_space_user(storage_space_metadata_id, user_id)\\nCheck: ck_portal_storage_space_grants_role: role IN ('Viewer', 'Editor')\\nIndexes: ix_portal_storage_space_grants_id(id) [index]; ix_portal_storage_space_grants_space(storage_space_metadata_id) [index]; ix_portal_storage_space_grants_user(user_id) [index]"
  }
  "portal_public_links": {
    class: table
    tooltip: "PK: id\\nUnique: uq_portal_public_links_token(token)\\nIndexes: ix_portal_public_links_account_bucket(account_id, bucket_name) [index]; ix_portal_public_links_expires(expires_at) [index]; ix_portal_public_links_id(id) [index]"
  }
  "portal_external_access_credentials": {
    class: table
    tooltip: "PK: id\\nUnique: uq_portal_external_access_credentials_access_key(access_key_id); uq_portal_external_access_credentials_iam_username(iam_username)\\nCheck: ck_portal_external_access_credentials_permission: permission IN ('read_only', 'read_write'); ck_portal_external_access_credentials_status: status IN ('Active', 'Inactive')\\nIndexes: ix_portal_external_access_credentials_account(account_id) [index]; ix_portal_external_access_credentials_creator(created_by_user_id) [index]; ix_portal_external_access_credentials_id(id) [index]; ix_portal_external_access_credentials_revoked(revoked_at) [index]; ix_portal_external_access_credentials_space(storage_space_metadata_id) [index]"
  }
  "portal_admin_requests": {
    class: table
    tooltip: "PK: id\\nCheck: ck_portal_admin_requests_status: status IN ('pending', 'processing', 'approved', 'rejected', 'failed'); ck_portal_admin_requests_type: request_type IN ('portal_user_access', 'portal_user_removal', 'account_quota_change', 'portal_setting_change')\\nIndexes: ix_portal_admin_requests_account_status(account_id, status, created_at) [index]; ix_portal_admin_requests_id(id) [index]; ix_portal_admin_requests_requester(requester_user_id, created_at) [index]; ix_portal_admin_requests_status_created(status, created_at) [index]"
  }
  "portal_admin_request_messages": {
    class: table
    tooltip: "PK: id\\nIndexes: ix_portal_admin_request_messages_author(author_user_id, created_at) [index]; ix_portal_admin_request_messages_id(id) [index]; ix_portal_admin_request_messages_request(request_id, created_at) [index]"
  }
}

