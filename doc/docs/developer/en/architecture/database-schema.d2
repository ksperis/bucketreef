"Storage and S3 execution": {
  style.fill: "#f8fafc"
  style.stroke: "#cbd5e1"
  "storage_endpoints": {
    class: table
    tooltip: "PK: id\\nUnique: unnamed(identity_namespace); uq_storage_endpoints_endpoint(endpoint_url); uq_storage_endpoints_name(name)\\nCheck: ck_storage_endpoints_endpoint_url_canonical: endpoint_url = trim(endpoint_url) AND endpoint_url NOT LIKE '%/' AND length(endpoint_url) > 0; ck_storage_endpoints_provider: provider IN ('ceph', 'aws', 'other')\\nIndexes: ix_storage_endpoints_id(id) [index]"
  }
  "endpoint_service_identities": {
    class: table
    tooltip: "PK: id\\nUnique: uq_endpoint_service_identity_kind(endpoint_id, kind)\\nCheck: ck_endpoint_service_identity_ceph_admin_external: kind != 'ceph_admin' OR mode = 'external'; ck_endpoint_service_identity_kind: kind IN ('runtime', 'supervision', 'ceph_admin'); ck_endpoint_service_identity_mode: mode IN ('managed', 'external'); ck_endpoint_service_identity_status: status IN ('not_provisioned', 'missing', 'provisioning', 'ready', 'error', 'revocation_pending', 'disabled')\\nIndexes: ix_endpoint_service_identities_endpoint_id(endpoint_id) [index]"
  }
  "key_rotation_intents": {
    class: table
    tooltip: "PK: id\\nUnique: uq_key_rotation_intent_target(endpoint_id, key_type, target_id)\\nCheck: ck_key_rotation_intent_phase: phase IN ('prepared', 'activated'); ck_key_rotation_intent_type: key_type IN ('endpoint_admin', 'endpoint_runtime', 'endpoint_supervision', 'ceph_admin', 'account', 's3_user')\\nIndexes: ix_key_rotation_intents_endpoint_id(endpoint_id) [index]"
  }
  "manager_access_key_metadata": {
    class: table
    tooltip: "PK: id\\nUnique: uq_manager_access_key_metadata_iam(account_id, principal_name, access_key_id); uq_manager_access_key_metadata_s3_user(s3_user_id, access_key_id)\\nCheck: ck_manager_access_key_metadata_scope: (account_id IS NOT NULL AND s3_user_id IS NULL AND principal_name IS NOT NULL) OR (account_id IS NULL AND s3_user_id IS NOT NULL AND principal_name IS NULL)\\nIndexes: ix_manager_access_key_metadata_access_key(access_key_id) [index]; ix_manager_access_key_metadata_expires_at(expires_at) [index]; ix_manager_access_key_metadata_id(id) [index]"
  }
  "s3_accounts": {
    class: table
    tooltip: "PK: id\\nUnique: unnamed(name); unnamed(rgw_account_id)\\nCheck: ck_s3_accounts_rgw_account_id_canonical: rgw_account_id = TRIM(rgw_account_id) AND LENGTH(rgw_account_id) > 0; ck_s3_accounts_rgw_user_uid_canonical: rgw_user_uid = TRIM(rgw_user_uid) AND LENGTH(rgw_user_uid) > 0\\nIndexes: ix_s3_accounts_id(id) [index]; ix_s3_accounts_storage_endpoint(storage_endpoint_id) [index]"
  }
  "user_s3_accounts": {
    class: table
    tooltip: "PK: id\\nUnique: uq_user_s3_account(user_id, account_id)\\nCheck: ck_user_s3_accounts_has_role: manager_role IS NOT NULL OR portal_role IS NOT NULL; ck_user_s3_accounts_manager_browser_role: allow_manager_browser_data_access IS FALSE OR manager_role = 'account_administrator'; ck_user_s3_accounts_manager_role: manager_role IS NULL OR manager_role = 'account_administrator'; ck_user_s3_accounts_portal_role: portal_role IS NULL OR portal_role IN ('portal_user', 'portal_manager')\\nIndexes: ix_user_s3_accounts_account_user(account_id, user_id) [index]; ix_user_s3_accounts_id(id) [index]"
  }
  "account_iam_users": {
    class: table
    tooltip: "PK: id\\nUnique: uq_account_iam_user(user_id, account_id); uq_account_iam_user_id(iam_user_id)\\nIndexes: ix_account_iam_users_account_user(account_id, user_id) [index]; ix_account_iam_users_id(id) [index]"
  }
  "s3_users": {
    class: table
    tooltip: "PK: id\\nUnique: uq_s3_users_endpoint_tenant_uid(storage_endpoint_id, rgw_tenant, rgw_user_uid)\\nCheck: ck_s3_users_rgw_user_uid_canonical: rgw_user_uid = TRIM(rgw_user_uid) AND LENGTH(rgw_user_uid) > 0\\nIndexes: ix_s3_users_id(id) [index]; ix_s3_users_storage_endpoint(storage_endpoint_id) [index]"
  }
  "user_s3_users": {
    class: table
    tooltip: "PK: id\\nUnique: uq_user_s3_user(user_id, s3_user_id)\\nIndexes: ix_user_s3_users_id(id) [index]; ix_user_s3_users_s3_user_user(s3_user_id, user_id) [index]"
  }
  "s3_connections": {
    class: table
    tooltip: "PK: id\\nIndexes: ix_s3_connections_created_by_user_id(created_by_user_id) [index]; ix_s3_connections_id(id) [index]; ix_s3_connections_storage_endpoint_id(storage_endpoint_id) [index]; uq_s3_connections_private_creator_name(created_by_user_id, name) [unique]; uq_s3_connections_shared_name(name) [unique]"
  }
  "user_s3_connections": {
    class: table
    tooltip: "PK: id\\nUnique: uq_user_s3_connection(user_id, s3_connection_id)\\nIndexes: ix_user_s3_connections_connection_user(s3_connection_id, user_id) [index]; ix_user_s3_connections_id(id) [index]"
  }
  "managed_private_accesses": {
    class: table
    tooltip: "PK: id\\nUnique: uq_managed_private_access_connection(s3_connection_id)\\nCheck: ck_managed_private_access_principal_type: remote_principal_type IN ('iam_user', 'rgw_user'); ck_managed_private_access_source_type: source_context_type IN ('account', 'connection', 's3_user'); ck_managed_private_access_state: state IN ('provisioning', 'active', 'deleting', 'cleanup_pending', 'failed')\\nIndexes: ix_managed_private_accesses_id(id) [index]; ix_managed_private_accesses_owner_user_id(owner_user_id) [index]; ix_managed_private_accesses_s3_connection_id(s3_connection_id) [index]; uq_managed_private_access_active_source(owner_user_id, source_context_type, source_context_id) [unique]"
  }
  "ui_group_s3_accounts": {
    class: table
    tooltip: "PK: id\\nUnique: uq_ui_group_s3_account(group_id, account_id)\\nCheck: ck_ui_group_s3_accounts_has_role: manager_role IS NOT NULL OR portal_role IS NOT NULL; ck_ui_group_s3_accounts_manager_browser_role: allow_manager_browser_data_access IS FALSE OR manager_role = 'account_administrator'; ck_ui_group_s3_accounts_manager_role: manager_role IS NULL OR manager_role = 'account_administrator'; ck_ui_group_s3_accounts_portal_role: portal_role IS NULL OR portal_role IN ('portal_user', 'portal_manager')\\nIndexes: ix_ui_group_s3_accounts_account_group(account_id, group_id) [index]; ix_ui_group_s3_accounts_id(id) [index]"
  }
  "ui_group_s3_users": {
    class: table
    tooltip: "PK: id\\nUnique: uq_ui_group_s3_user(group_id, s3_user_id)\\nIndexes: ix_ui_group_s3_users_id(id) [index]; ix_ui_group_s3_users_s3_user_group(s3_user_id, group_id) [index]"
  }
  "ui_group_s3_connections": {
    class: table
    tooltip: "PK: id\\nUnique: uq_ui_group_s3_connection(group_id, s3_connection_id)\\nIndexes: ix_ui_group_s3_connections_connection_group(s3_connection_id, group_id) [index]; ix_ui_group_s3_connections_id(id) [index]"
  }
}

