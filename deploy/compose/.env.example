# Copy to .env. The release packager replaces this version with its exact tag.
BUCKETREEF_TAG=0.2.7
APP_ENV=development
# Normally set by the selected Compose profile override.
DEPLOYMENT_PROFILE=full
# Informational only; QuickStart sets this to quickstart.
ONBOARDING_SOURCE=standard
# Generate four DIFFERENT values with: openssl rand -hex 48
UI_JWT_KEYS=["replace-with-a-random-secret"]
API_JWT_KEYS=["replace-with-a-different-random-secret"]
CREDENTIAL_KEYS=["replace-with-another-random-secret"]
INTERNAL_CRON_TOKEN=replace-with-a-fourth-random-secret
BUCKETREEF_BIND_ADDRESS=127.0.0.1
BUCKETREEF_BACKEND_PORT=8000
BUCKETREEF_FRONTEND_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
PUBLIC_ORIGINS=[]
WEBAUTHN_ORIGIN=http://localhost:8080
WEBAUTHN_ORIGINS=[]
WEBAUTHN_RP_ID=localhost
CORS_ORIGINS=["http://localhost:8080"]
ALLOWED_HOSTS=["localhost","127.0.0.1","backend"]
TRUSTED_PROXY_CIDRS=[]
# Split admin/user deployments must use the same PostgreSQL database URL.
# DATABASE_URL=postgresql+psycopg://bucketreef@postgres.example/bucketreef
